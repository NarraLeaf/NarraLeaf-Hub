{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    // Node runs this package as native ESM ("type": "module"), so relative
    // imports are written with the .js extension the runtime actually resolves.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    // esbuild produces dist/, so the compiler is only ever used as a checker.
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
